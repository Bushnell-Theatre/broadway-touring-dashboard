# Normalize line endings to LF in the repo; checkout as-is on all platforms
* text=auto eol=lf

# Windows batch files must check out with CRLF - cmd.exe mis-parses LF-only .bat
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Explicitly binary — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.zip  binary
*.xlsx binary
*.pdf  binary
